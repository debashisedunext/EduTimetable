{
  "name": "edutimetable",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:isolation": "sh scripts/isolation-suite.sh",
    "test:freeze": "node scripts/freeze-smoke.cjs",
    "test:staffing": "node scripts/staffing-smoke.cjs",
    "test:grids": "node scripts/reports-grid-smoke.cjs",
    "test:groups": "node scripts/resource-groups-smoke.cjs",
    "test:pools": "node scripts/individual-pool-smoke.cjs",
    "test:classfloor": "node scripts/classes-floor-smoke.cjs",
    "test:subjects": "node scripts/timetable-subjects-smoke.cjs",
    "test:periods": "node scripts/class-period-span-smoke.cjs",
    "test:mastergrid": "node scripts/master-grid-smoke.cjs",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "eslint": "^9.18.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript-eslint": "^8.20.0"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.0"
  }
}
