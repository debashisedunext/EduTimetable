{
  "name": "@edutimetable/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start:dev": "nest start --watch",
    "start:worker:dev": "tsx watch src/worker.ts",
    "seed": "tsx prisma/seed.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "generate:control": "prisma generate --schema prisma/control/schema.prisma",
    "migrate:control": "prisma migrate deploy --schema prisma/control/schema.prisma",
    "seed:control": "tsx prisma/control/seed.ts",
    "tenant:create": "tsx prisma/control/create-tenant.ts",
    "migrate:all": "tsx prisma/control/migrate-all.ts",
    "platform:admin": "tsx prisma/control/platform-admin.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@edutimetable/shared": "workspace:*",
    "@nestjs/bullmq": "^11.0.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/platform-socket.io": "^11.0.0",
    "@nestjs/websockets": "^11.0.0",
    "@node-rs/argon2": "^2.2.0",
    "@prisma/client": "^6.2.0",
    "bullmq": "^5.34.0",
    "exceljs": "^4.4.0",
    "ioredis": "^5.4.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^9.1.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.1",
    "prisma": "^6.2.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
