// Phase 0 scope: identity, roles, permissions, ERP SSO mapping (§15).
// The timetabling domain tables (§3) arrive with Phase 1 migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ===================== PHASE 9.2 (§17): THE SCHOOL ITSELF =====================

enum SchoolOrigin {
  /// Provisioned from an ERP SSO token; identity is the ERP's.
  erp
  /// Created here by a self-serve account; identity is the admin's.
  self_serve
}

/// Until Phase 9.2, `school_id` was a bare Int on 30 tables with no parent row
/// anywhere — no name, no code, and nothing stopping a typo from inventing a
/// school. This is that missing parent: every school_id column now has a real
/// foreign key to it, so a row can only belong to a school that exists.
///
/// `code` is the stable identifier the ERP knows this school by, and is what
/// the control-plane tenant registry (prisma/control/schema.prisma) resolves an
/// incoming SSO token against — a numeric id is meaningless across databases.
model School {
  id                 Int          @id @default(autoincrement())
  code               String       @unique @db.VarChar(40)
  name               String       @db.VarChar(120)
  shortName          String?      @map("short_name") @db.VarChar(40)
  logoUrl            String?      @map("logo_url") @db.VarChar(255)
  timezone           String       @default("Asia/Kolkata") @db.VarChar(40)
  address            String?      @db.VarChar(255)
  /// The trust this school belongs to, as the ERP reports it. Denormalized
  /// from the control-plane `trusts` table because /me reads it on every page
  /// load and the ERP is the source of truth for both — refreshed on every
  /// login, so the two cannot meaningfully drift (§17.4).
  trustCode          String?      @map("trust_code") @db.VarChar(40)
  trustName          String?      @map("trust_name") @db.VarChar(120)
  /// §15.3 Phase 25.1 — where this school's identity came from, and therefore
  /// whether anybody here may edit it.
  ///
  /// `erp`: the ERP named it, and refreshes that name on EVERY login. Letting
  /// an admin edit it would produce an edit that silently reverts, and a bug
  /// report nobody who did not sign in again can reproduce.
  /// `self_serve`: an admin typed it, because nobody else knows it.
  ///
  /// One column decides read-only vs editable on Step 1, School Profile, My
  /// Schools and Users — rather than each screen guessing.
  origin             SchoolOrigin @default(erp)
  /// Which self-serve account created it. Null for ERP schools.
  createdByAccountId Int?         @map("created_by_account_id")
  /// When the ERP last wrote this school's NAME from an SSO token.
  ///
  /// The distinction `origin` alone cannot make. Phase 9.2 back-filled schools
  /// with PLACEHOLDER names ("School 1") for rows predating school claims, and
  /// documented that an admin fixes them on the Masters screen — those schools
  /// receive no name from the ERP, so an edit is never overwritten and refusing
  /// it would strand them called "School 1" forever. A school the ERP genuinely
  /// names is the opposite case: an edit there really would silently revert on
  /// the next login. Null means "the ERP has never named this", which is the
  /// only honest test.
  erpNameSyncedAt    DateTime?    @map("erp_name_synced_at")
  isActive           Boolean      @default(true) @map("is_active")
  createdAt          DateTime     @default(now()) @map("created_at")

  roles                       Role[]
  rolePermissions             RolePermission[]
  users                       User[]
  erpRoleMappings             ErpRoleMapping[]
  academicYears               AcademicYear[]
  timetableGroups             TimetableGroup[]
  academicTerms               AcademicTerm[]
  classes                     SchoolClass[]
  sections                    Section[]
  classSections               ClassSection[]
  rooms                       Room[]
  subjects                    Subject[]
  teachers                    Teacher[]
  teacherUnavailability       TeacherUnavailability[]
  classSectionUnavailability  ClassSectionUnavailability[]
  subjectUnavailability       SubjectUnavailability[]
  roomUnavailability          RoomUnavailability[]
  teacherClassEligibility     TeacherClassEligibility[]
  roomSubjects                RoomSubject[]
  extraClasses                ExtraClass[]
  classSubjects               ClassSubject[]
  teacherSubjectClassSections TeacherSubjectClassSection[]
  timetableConfigs            TimetableConfig[]
  periods                     Period[]
  holidays                    Holiday[]
  mergedTeachingGroups        MergedTeachingGroup[]
  mergedTeachingGroupMembers  MergedTeachingGroupMember[]
  electiveBlocks              ElectiveBlock[]
  electiveBlockMembers        ElectiveBlockMember[]
  electiveOptions             ElectiveOption[]
  auditLogs                   AuditLog[]
  timetableSlots              TimetableSlot[]
  timetablePublications       TimetablePublication[]
  teacherAbsences             TeacherAbsence[]
  substitutionLogs            SubstitutionLog[]
  notifications               Notification[]
  aiSettings                  AiSettings[]
  aiChatLogs                  AiChatLog[]
  autoFixRuns                 AutoFixRun[]
  timetableDrafts             TimetableDraft[]
  erpSyncRuns                 ErpSyncRun[]
  onboardingSessions          OnboardingSession[]

  dailyActivities        DailyActivity[]
  teacherSubjects        TeacherSubject[]
  subjectClasses         SubjectClass[]
  timetableSubjects      TimetableSubject[]
  timetableClassSpans    TimetableClassSpan[]
  staffingChanges        StaffingChange[]
  staffingChangeTeachers StaffingChangeTeacher[]
  staffingChangeItems    StaffingChangeItem[]

  @@map("schools")
}

model Role {
  id          Int              @id @default(autoincrement())
  schoolId    Int              @map("school_id")
  school      School           @relation(fields: [schoolId], references: [id])
  name        String           @db.VarChar(50)
  isSystem    Boolean          @default(false) @map("is_system")
  permissions RolePermission[]
  users       User[]
  erpMappings ErpRoleMapping[]

  @@unique([schoolId, name])
  @@map("roles")
}

model RolePermission {
  roleId     Int    @map("role_id")
  permission String @db.VarChar(40)
  role       Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  // §17 / 9.1: denormalized from the parent so scoping is always a direct
  // indexed predicate rather than a join. Maintained by the Prisma scope
  // extension, never written by callers.
  schoolId   Int    @map("school_id")
  school     School @relation(fields: [schoolId], references: [id])

  @@id([roleId, permission])
  @@index([schoolId])
  @@map("role_permissions")
}

model User {
  id                    Int            @id @default(autoincrement())
  schoolId              Int            @map("school_id")
  school                School         @relation(fields: [schoolId], references: [id])
  /// The stable external identity of this person.
  ///
  /// For an ERP user it is the ERP's own id. For somebody who signed in with a
  /// password it is `local:{account_id}` — synthetic, but stable and unique,
  /// which is all this column has ever needed to be. Writing it that way keeps
  /// `@@unique([schoolId, erpUserId])`, the session token and every scope
  /// filter working untouched. (The name now slightly overstates itself;
  /// renaming it to `external_user_id` touches auth, SSO, platform admin and
  /// the isolation sweep, and is its own change.)
  erpUserId             String         @map("erp_user_id") @db.VarChar(50)
  /// §15.3 — the control-plane account that signs in as this user. Null for
  /// ERP users, who have no account and never will.
  accountId             Int?           @map("account_id")
  name                  String         @db.VarChar(100)
  email                 String         @db.VarChar(120)
  // FK to teachers arrives in Phase 1; kept as a plain nullable column until then.
  teacherId             Int?           @map("teacher_id")
  roleId                Int            @map("role_id")
  role                  Role           @relation(fields: [roleId], references: [id])
  isActive              Boolean        @default(true) @map("is_active")
  /// set by an Admin override on the Roles & Responsibility page; when true,
  /// sync-on-login must NOT reset the role from the ERP mapping (§15.1)
  roleOverridden        Boolean        @default(false) @map("role_overridden")
  lastLoginAt           DateTime?      @map("last_login_at")
  /// §15.3 Phase 25.2 — when THIS user last said "I'll do it later".
  ///
  /// Per user rather than per school on purpose: one admin dismissing the
  /// welcome screen must not hide it from a colleague who has never seen it.
  onboardingDismissedAt DateTime?      @map("onboarding_dismissed_at")
  createdAt             DateTime       @default(now()) @map("created_at")
  notifications         Notification[]

  @@unique([schoolId, erpUserId])
  @@map("users")
}

model ErpRoleMapping {
  id       Int    @id @default(autoincrement())
  schoolId Int    @map("school_id")
  school   School @relation(fields: [schoolId], references: [id])
  erpRole  String @map("erp_role") @db.VarChar(50)
  roleId   Int    @map("role_id")
  role     Role   @relation(fields: [roleId], references: [id])

  @@unique([schoolId, erpRole])
  @@map("erp_role_mappings")
}

// ===================== PHASE 1: TIMETABLING DOMAIN (§3, §3.10, §4.7-4.9) =====================

/// §4.9 Phase 15 — how a split elective's slot is chosen.
enum ElectivePlacement {
  solver
  same_period
  fixed
}

enum RoomType {
  classroom
  lab
  sports
  music
  art
  auditorium
  other
}

/// §26.2 — the two halves of an Indian school's curriculum. Scholastic subjects
/// are examined; co-scholastic ones (art, music, games, library) are not.
enum SubjectCategory {
  scholastic
  co_scholastic
}

/// §26.3 — which side of the lunch break a subject may be taught on.
enum SubjectLunchRule {
  any
  before
  after
}

/// §26.5 — where a teacher's plain-English instruction got to.
///
/// `pending` is a freshly typed instruction awaiting evaluation, and the state
/// one returns to when the text changes: an instruction is re-evaluated when it
/// is edited, never silently re-run later against a different model.
enum InstructionStatus {
  pending
  accepted
  denied
}

enum ClassTeacherPeriodRule {
  none
  always_first_period
  random
}

/// §18 — how a teacher is engaged. Recorded on every teacher, and load-bearing
/// in two places: a guest may not be mapped into the regular curriculum (they
/// take extra classes only), and guests are not offered as substitutes.
enum TeacherGender {
  male
  female
  other
}

enum EmploymentType {
  permanent
  adhoc
  guest
}

enum PeriodPattern {
  every_period
  alternate_period
  alternate_day
}

enum TimetableConfigStatus {
  draft
  active
  archived
}

model AcademicYear {
  id               Int               @id @default(autoincrement())
  schoolId         Int               @map("school_id")
  school           School            @relation(fields: [schoolId], references: [id])
  name             String            @db.VarChar(20)
  startDate        DateTime          @map("start_date") @db.Date
  endDate          DateTime          @map("end_date") @db.Date
  isActive         Boolean           @default(true) @map("is_active")
  classSections    ClassSection[]
  timetableConfigs TimetableConfig[]
  classSubjects    ClassSubject[]
  holidays         Holiday[]
  terms            AcademicTerm[]
  timetableGroups  TimetableGroup[]

  @@unique([schoolId, name])
  @@map("academic_years")
}

/// §25 Phase 26 — a session that runs as terms rather than as one year.
///
/// **No flag says which mode a session is in.** A session is term-wise if and
/// only if it has rows here, which is one source of truth rather than two that
/// can come to disagree — the same reasoning as "an empty eligibility scope
/// means *not stated*" (§18).
///
/// Terms belong to the SESSION, not to a timetable: they are the school's
/// calendar, so every wing shares them. What differs per term is where lessons
/// sit, never what is taught — the curriculum, the mappings and the Readiness
/// score are shared across all of them (§25.1).
model AcademicTerm {
  id             Int                    @id @default(autoincrement())
  schoolId       Int                    @map("school_id")
  school         School                 @relation(fields: [schoolId], references: [id])
  academicYearId Int                    @map("academic_year_id")
  academicYear   AcademicYear           @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  /// What the school calls it: "Term 1", "Semester 1", "Autumn Term".
  name           String                 @db.VarChar(30)
  /// Position in the year. The dates decide what a term MEANS; this decides
  /// the order dropdowns list them in, and survives a term being re-dated.
  sortOrder      Int                    @map("sort_order") @db.SmallInt
  startDate      DateTime               @map("start_date") @db.Date
  endDate        DateTime               @map("end_date") @db.Date
  createdAt      DateTime               @default(now()) @map("created_at")
  slots          TimetableSlot[]
  drafts         TimetableDraft[]
  publications   TimetablePublication[]
  extraClasses   ExtraClass[]

  @@unique([schoolId, academicYearId, sortOrder], map: "uq_term_order")
  @@unique([schoolId, academicYearId, name], map: "uq_term_name")
  @@index([schoolId])
  @@index([academicYearId, startDate, endDate])
  @@map("academic_terms")
}

model SchoolClass {
  id               Int                       @id @default(autoincrement())
  schoolId         Int                       @map("school_id")
  school           School                    @relation(fields: [schoolId], references: [id])
  name             String                    @db.VarChar(20)
  sequence         Int                       @default(0)
  sections         Section[]
  classSections    ClassSection[]
  classSubjects    ClassSubject[]
  eligibleTeachers TeacherClassEligibility[]
  /// §27.16 — the subjects DECLARED as taught to this class.
  subjectClasses   SubjectClass[]
  /// §33 — how long one of this class's lessons is, per timetable.
  periodSpans      TimetableClassSpan[]

  @@unique([schoolId, name])
  @@map("classes")
}

model Section {
  id            Int            @id @default(autoincrement())
  classId       Int            @map("class_id")
  class         SchoolClass    @relation(fields: [classId], references: [id], onDelete: Cascade)
  name          String         @db.VarChar(10)
  schoolId      Int            @map("school_id")
  school        School         @relation(fields: [schoolId], references: [id])
  classSections ClassSection[]

  @@unique([classId, name])
  @@index([schoolId])
  @@map("sections")
}

model ClassSection {
  id                       Int                          @id @default(autoincrement())
  classId                  Int                          @map("class_id")
  class                    SchoolClass                  @relation(fields: [classId], references: [id])
  sectionId                Int                          @map("section_id")
  section                  Section                      @relation(fields: [sectionId], references: [id])
  academicYearId           Int                          @map("academic_year_id")
  academicYear             AcademicYear                 @relation(fields: [academicYearId], references: [id])
  /// §30 — the pool that OWNS this cohort row. `timetableConfigId` below then
  /// means "which timetable IN THIS POOL teaches it", and null still means "not
  /// attached yet" — available to the pool, not to the school.
  resourceGroupId          Int                          @map("resource_group_id")
  resourceGroup            TimetableGroup               @relation(fields: [resourceGroupId], references: [id])
  // §3.10 / §30: within a resource group, a class-section belongs to exactly
  // ONE timetable config (null = unassigned)
  timetableConfigId        Int?                         @map("timetable_config_id")
  timetableConfig          TimetableConfig?             @relation(fields: [timetableConfigId], references: [id])
  homeRoomId               Int?                         @map("home_room_id")
  homeRoom                 Room?                        @relation(fields: [homeRoomId], references: [id])
  strength                 Int?
  schoolId                 Int                          @map("school_id")
  school                   School                       @relation(fields: [schoolId], references: [id])
  classTeacherId           Int?                         @map("class_teacher_id")
  classTeacher             Teacher?                     @relation("classTeacherOf", fields: [classTeacherId], references: [id])
  mappings                 TeacherSubjectClassSection[]
  mergedGroupMemberships   MergedTeachingGroupMember[]
  electiveBlockMemberships ElectiveBlockMember[]
  unavailability           ClassSectionUnavailability[]
  extraClasses             ExtraClass[]

  /// §30 — Class 1-A exists once PER POOL, not once per school-year. That one
  /// column is what lets an individual timetable hold its own Class 1-A with
  /// its own class teacher, home room and Maths teacher.
  @@unique([classId, sectionId, academicYearId, resourceGroupId], map: "uq_section_in_group")
  @@index([schoolId])
  @@index([resourceGroupId], map: "class_sections_group_idx")
  @@map("class_sections")
}

model Room {
  id              Int                          @id @default(autoincrement())
  schoolId        Int                          @map("school_id")
  school          School                       @relation(fields: [schoolId], references: [id])
  name            String                       @db.VarChar(50)
  capacity        Int?
  roomType        RoomType                     @default(classroom) @map("room_type")
  isShared        Boolean                      @default(false) @map("is_shared")
  homeRoomOf      ClassSection[]
  /// §19: which subjects this room serves. Only meaningful for special rooms —
  /// a lab with no subjects listed is a general lab and serves any lab subject.
  subjects        RoomSubject[]
  preferredFor    TeacherSubjectClassSection[]
  mergedGroups    MergedTeachingGroup[]
  electiveOptions ElectiveOption[]
  extraClasses    ExtraClass[]

  dailyActivities DailyActivity[]
  unavailability  RoomUnavailability[]

  @@unique([schoolId, name])
  @@map("rooms")
}

/// §19 — a room dedicated to a subject. "Bio Lab teaches Biology", so a
/// Biology period can never be sent to the Physics lab just because it was free.
model RoomSubject {
  roomId    Int     @map("room_id")
  room      Room    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  subjectId Int     @map("subject_id")
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  schoolId  Int     @map("school_id")
  school    School  @relation(fields: [schoolId], references: [id])

  @@id([roomId, subjectId])
  @@index([schoolId])
  @@map("room_subjects")
}

model Subject {
  id                   Int                          @id @default(autoincrement())
  schoolId             Int                          @map("school_id")
  school               School                       @relation(fields: [schoolId], references: [id])
  name                 String                       @db.VarChar(50)
  code                 String?                      @db.VarChar(10)
  /// §26.2 — scholastic or co-scholastic. Groups reports, and is what makes
  /// the intelligent placement defaults defensible: a co-scholastic subject is
  /// the one that yields the morning periods.
  category             SubjectCategory              @default(scholastic)
  /// §26.2 — 1..5, higher is earlier in the day. A PREFERENCE, not a rule:
  /// "Maths must be in period 1" cannot hold for twenty sections at once. It is
  /// a term in the §5.6 objective, which the CSP's value ordering and CP-SAT
  /// both read, so the two engines cannot disagree about what "nicer" means.
  priority             Int                          @default(3) @db.TinyInt
  /// §26.3 — which side of lunch this subject may be taught. HARD: pruned out
  /// of the domain before search, and checked by Feasibility Check 10 first.
  lunchRule            SubjectLunchRule             @default(any) @map("lunch_rule")
  /// §26.3 — may not occupy the period IMMEDIATELY after lunch. A different
  /// rule from `lunchRule = after`, and commonly wanted with it: Games cannot
  /// be held on a full stomach.
  gapAfterLunch        Boolean                      @default(false) @map("gap_after_lunch")
  isLab                Boolean                      @default(false) @map("is_lab")
  /// §19.1 — this subject is always taught in its OWN room, never the class's
  /// home room. WHERE is not here: the rooms come from `room_subjects`, which
  /// has meant "this room serves these subjects" since §19. A room id beside
  /// this flag would be a second answer to "where does Music happen?", free to
  /// disagree with the first, and could not describe a school with two music
  /// rooms. Flag set but nothing mapped falls back to the home room, and
  /// Feasibility Check 5b says so rather than the timetable going quietly wrong.
  taughtInOwnRoom      Boolean                      @default(false) @map("taught_in_own_room")
  requiresDoublePeriod Boolean                      @default(false) @map("requires_double_period")
  classSubjects        ClassSubject[]
  mappings             TeacherSubjectClassSection[]
  mergedGroups         MergedTeachingGroup[]
  electiveOptions      ElectiveOption[]
  extraClasses         ExtraClass[]
  rooms                RoomSubject[]

  teacherSubjects TeacherSubject[]
  unavailability  SubjectUnavailability[]
  /// §27.16 — the classes this subject is DECLARED for. Empty = not stated.
  classes         SubjectClass[]
  /// §32 — the timetables that have DECLARED this subject. Empty = not stated.
  timetables      TimetableSubject[]

  @@unique([schoolId, name])
  @@map("subjects")
}

model Teacher {
  id                          Int                          @id @default(autoincrement())
  schoolId                    Int                          @map("school_id")
  school                      School                       @relation(fields: [schoolId], references: [id])
  employeeCode                String                       @map("employee_code") @db.VarChar(20)
  name                        String                       @db.VarChar(100)
  maxPeriodsPerDay            Int                          @default(6) @map("max_periods_per_day")
  /// §20: the floor to go with the cap. A teacher works a day properly or not
  /// at all — never a single period. `max` bounds the top of the range, this
  /// bounds the bottom, and the solver treats a day as "0 or at least this".
  minPeriodsPerDay            Int                          @default(3) @map("min_periods_per_day")
  maxPeriodsPerWeek           Int                          @default(30) @map("max_periods_per_week")
  classTeacherPeriodRule      ClassTeacherPeriodRule       @default(none) @map("class_teacher_period_rule")
  periodPattern               PeriodPattern                @default(every_period) @map("period_pattern")
  alternateDaySet             Json?                        @map("alternate_day_set")
  /// §15.3 Phase 25.4 — recorded for the staff directory and printed lists.
  /// Never used to authorise or to schedule anything.
  gender                      TeacherGender?
  /// Short form for grids and printed timetables, where a full name will not
  /// fit. Proposed from first + last name, editable, and NOT unique-enforced:
  /// a school with an Anil Yadav and an Ajay Yadav will have a collision the
  /// grid resolves visibly rather than the database refusing at 3am.
  initials                    String?                      @db.VarChar(6)
  /// Where an invitation is sent (§15.3 Phase 25.6). Nullable — a teacher who
  /// never signs in does not need one.
  email                       String?                      @db.VarChar(120)
  /// §15.3 Phase 25.4 — the longest run of back-to-back periods this teacher
  /// will take in one day.
  ///
  /// Null means no limit. ENFORCED by `SolverState.check()`, not merely stored:
  /// a field that records a preference the solver ignores is worse than no
  /// field, because it reads as a promise. Being in `check()` means the board's
  /// drag-and-drop and the legal-destination highlighting honour it too — one
  /// rules engine, three call sites.
  maxConsecutivePeriodsPerDay Int?                         @map("max_consecutive_periods_per_day")
  /// Whether this teacher may be offered as a substitute (§9).
  ///
  /// A refusal, not a low score — the same treatment §4.7a unavailability gets.
  /// Somebody who has said they will not cover should not appear at the bottom
  /// of the list; they should not appear.
  canSubstitute               Boolean                      @default(true) @map("can_substitute")
  employmentType              EmploymentType               @default(permanent) @map("employment_type")
  isActive                    Boolean                      @default(true) @map("is_active")
  /// §18: which classes this teacher may be given at all. A primary teacher
  /// cannot be mapped to Class 12 however the mapping is created — and unlike
  /// the grade band the substitute engine used to derive from existing
  /// mappings, this is *declared*, so it can constrain the mappings rather
  /// than merely describe them.
  /// §26.5 — what the school said about this teacher, in their own words.
  ///
  /// Kept verbatim and kept even when refused: it is what a person typed, and
  /// discarding it to teach them about phrasing is not our call.
  specialInstruction          String?                      @map("special_instruction") @db.Text
  instructionStatus           InstructionStatus?           @map("instruction_status")
  /// §26.5 — what the instruction BECAME: constraints the engine already
  /// enforces. This is the authority. Remove the school's AI key tomorrow and
  /// the timetable does not change, because by then these are ordinary rows.
  instructionCompiled         Json?                        @map("instruction_compiled")
  /// Why it was refused, or the plain-English read-back of what was understood
  /// — so the green tick is auditable rather than trusted.
  instructionNote             String?                      @map("instruction_note") @db.VarChar(400)
  instructionAt               DateTime?                    @map("instruction_at")
  eligibility                 TeacherClassEligibility[]
  extraClasses                ExtraClass[]
  unavailability              TeacherUnavailability[]
  mappings                    TeacherSubjectClassSection[]
  classTeacherOf              ClassSection[]               @relation("classTeacherOf")
  mergedGroups                MergedTeachingGroup[]
  electiveOptions             ElectiveOption[]
  absences                    TeacherAbsence[]

  dailyActivities DailyActivity[]
  teacherSubjects TeacherSubject[]
  /// §29.2 — the staffing changes this teacher is named in, on either side.
  staffingChanges StaffingChangeTeacher[]

  @@unique([schoolId, employeeCode])
  @@map("teachers")
}

/// Which classes a teacher may teach (§18). A set rather than a range: the PE
/// teacher covers Nursery and Class 12, and a range cannot say that.
model TeacherClassEligibility {
  teacherId Int         @map("teacher_id")
  teacher   Teacher     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  classId   Int         @map("class_id")
  class     SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  schoolId  Int         @map("school_id")
  school    School      @relation(fields: [schoolId], references: [id])

  @@id([teacherId, classId])
  @@index([schoolId])
  @@map("teacher_class_eligibility")
}

/// §33 — how many BASE periods one of this class's lessons occupies.
///
/// A school running Class 1 on 30-minute periods and Class 10 on 60-minute
/// periods, same start and same finish, is not two clocks: 60 is exactly two
/// 30s, so there is one grid of eight 30-minute periods and Class 10's lessons
/// are **double periods** on it. `span` is that multiplier — 1 for Class 1, 2
/// for Class 10.
///
/// **Why this is safe where §28.5 is not.** §28.5 refuses two unaligned period
/// lengths because `uq_teacher_slot` compares period NUMBERS, so a teacher in
/// Class 9 P3 and Class 11 P2 overlaps in wall clock and the database cannot
/// see it. A double period has no such hole: `writer.ts` emits **one slot row
/// per period in the span**, so an hour holds period 1 *and* period 2 and the
/// same unique index refuses the collision. It is stricter than the wings
/// route (§30), where a shared teacher's cross-wing overlap is only a warning.
///
/// **A span, not a duration in minutes.** The solver needs a block size in base
/// periods, and storing minutes would mean re-deriving it everywhere and
/// refusing whenever the config's own duration changed underneath. Minutes are
/// what the SCREEN shows — `span × timetable_config.period_duration_mins` — so
/// changing the base from 30 to 35 moves every class proportionally, which is
/// what a school means by "make the periods longer".
///
/// Keyed by `(timetable_config_id, class_id)` rather than on `classes`: the
/// base duration belongs to the config (§28), so the same span means different
/// minutes in different timetables, and §30.9 lets one class sit in two pools.
///
/// **Empty means "not stated", never span 0** (invariant 7) — every class in
/// every school today has no row and therefore span 1, which is what it has
/// now. That is what makes the migration a bare CREATE TABLE.
model TimetableClassSpan {
  timetableConfigId Int             @map("timetable_config_id")
  timetableConfig   TimetableConfig @relation(fields: [timetableConfigId], references: [id], onDelete: Cascade)
  classId           Int             @map("class_id")
  class             SchoolClass     @relation(fields: [classId], references: [id], onDelete: Cascade)
  /// Base periods per lesson. Always >= 1; 1 is the same as having no row.
  span              Int             @default(1)
  schoolId          Int             @map("school_id")
  school            School          @relation(fields: [schoolId], references: [id])

  @@id([timetableConfigId, classId])
  @@index([schoolId])
  @@index([classId])
  @@map("timetable_class_spans")
}

/// §32 — which subjects a TIMETABLE teaches, declared per `timetable_config`.
///
/// `subjects` is school-wide and stays that way: a subject is entered once and
/// used for ever (§27.12). What differs between timetables is which of them a
/// given week actually runs — a Junior wing that does not teach Chemistry, an
/// individual timetable set up for a handful of languages. Before this, every
/// timetable saw every subject the school had ever entered.
///
/// **Per `timetable_config`, deliberately not per §30 pool.** Two grouped wings
/// share a pool and are exactly the case that motivates this: Junior and Senior
/// are one resource group and teach different subjects. A pool-level answer
/// could not say that.
///
/// **Empty means "not stated", never "teaches nothing"** (invariant 7). That is
/// what makes the migration a bare `CREATE TABLE` with no backfill: every
/// timetable that exists today has no rows and therefore keeps seeing every
/// subject, which is what it sees now. It also means the table is only ever
/// *written* by somebody actively choosing — a school that never opens the
/// screen is never silently narrowed.
///
/// Selection only. The subject's own settings — code, category, priority,
/// placement, lab, own room, double — are one answer per subject, school-wide,
/// because they describe the subject rather than the week.
model TimetableSubject {
  timetableConfigId Int             @map("timetable_config_id")
  timetableConfig   TimetableConfig @relation(fields: [timetableConfigId], references: [id], onDelete: Cascade)
  subjectId         Int             @map("subject_id")
  subject           Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  schoolId          Int             @map("school_id")
  school            School          @relation(fields: [schoolId], references: [id])

  @@id([timetableConfigId, subjectId])
  @@index([schoolId])
  @@index([subjectId])
  @@map("timetable_subjects")
}

/// §27.16 — which classes a subject is taught to, DECLARED rather than guessed.
///
/// §27.15's ladder ranges already keep Biology out of Pre-Nursery, but they read
/// the subject's NAME: an opinion good enough to shape a proposal and never good
/// enough to be a statement. This is the statement. Where it exists it wins, and
/// the ladder has nothing to say about that subject.
///
/// Empty means "not stated", never "no classes" (invariant 7) — which is what
/// keeps every school that predates it behaving exactly as it does today.
model SubjectClass {
  subjectId Int         @map("subject_id")
  subject   Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  classId   Int         @map("class_id")
  class     SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  schoolId  Int         @map("school_id")
  school    School      @relation(fields: [schoolId], references: [id])

  @@id([subjectId, classId])
  @@index([schoolId])
  @@index([classId])
  @@map("subject_classes")
}

model TeacherUnavailability {
  id           Int     @id @default(autoincrement())
  teacherId    Int     @map("teacher_id")
  teacher      Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  dayOfWeek    Int     @map("day_of_week") @db.TinyInt
  periodNumber Int?    @map("period_number")
  reason       String? @db.VarChar(100)
  schoolId     Int     @map("school_id")
  school       School  @relation(fields: [schoolId], references: [id])

  @@index([schoolId])
  @@map("teacher_unavailability")
}

/// §4.7b — the class is not in school then. Unlike the other three, this one
/// makes the WEEK SMALLER: Check 1 subtracts these cells from a section's
/// available slots, or a class with Friday afternoon off reads as having 40
/// periods to fill and the solver fails on a curriculum that no longer fits.
model ClassSectionUnavailability {
  id             Int          @id @default(autoincrement())
  classSectionId Int          @map("class_section_id")
  classSection   ClassSection @relation(fields: [classSectionId], references: [id], onDelete: Cascade)
  dayOfWeek      Int          @map("day_of_week") @db.TinyInt
  /// NULL = the whole day, so a blocked Friday survives a period being added.
  periodNumber   Int?         @map("period_number")
  reason         String?      @db.VarChar(100)
  schoolId       Int          @map("school_id")
  school         School       @relation(fields: [schoolId], references: [id])

  @@index([schoolId])
  @@index([classSectionId])
  @@map("class_section_unavailability")
}

/// §4.7b — this subject may not be taught then, for anybody. A generalisation
/// of §26.3's lunch rules, which stay as they are: "not straight after lunch"
/// follows the break wherever it moves, where these are fixed cells.
model SubjectUnavailability {
  id           Int     @id @default(autoincrement())
  subjectId    Int     @map("subject_id")
  subject      Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  dayOfWeek    Int     @map("day_of_week") @db.TinyInt
  periodNumber Int?    @map("period_number")
  reason       String? @db.VarChar(100)
  schoolId     Int     @map("school_id")
  school       School  @relation(fields: [schoolId], references: [id])

  @@index([schoolId])
  @@index([subjectId])
  @@map("subject_unavailability")
}

/// §4.7b — the room cannot be used then. Reduces the supply the §19.1 and §19
/// room checks measure against, as well as pruning the solver's choice.
model RoomUnavailability {
  id           Int     @id @default(autoincrement())
  roomId       Int     @map("room_id")
  room         Room    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  dayOfWeek    Int     @map("day_of_week") @db.TinyInt
  periodNumber Int?    @map("period_number")
  reason       String? @db.VarChar(100)
  schoolId     Int     @map("school_id")
  school       School  @relation(fields: [schoolId], references: [id])

  @@index([schoolId])
  @@index([roomId])
  @@map("room_unavailability")
}

/// The curriculum: what a class studies in a given year, and how it is spread.
/// Phase 19 — scoped by ACADEMIC YEAR, not just by class. Without the year one
/// row served every session at once, so editing next year's periods/week
/// silently rewrote what last year's readiness report said. Scoped by year
/// rather than by config because what Class 5 studies belongs to the session,
/// not to whichever wing timetables it.
model ClassSubject {
  id                       Int          @id @default(autoincrement())
  classId                  Int          @map("class_id")
  class                    SchoolClass  @relation(fields: [classId], references: [id], onDelete: Cascade)
  academicYearId           Int          @map("academic_year_id")
  academicYear             AcademicYear @relation(fields: [academicYearId], references: [id])
  subjectId                Int          @map("subject_id")
  subject                  Subject      @relation(fields: [subjectId], references: [id])
  periodsPerWeek           Int          @map("periods_per_week")
  maxPeriodsPerDay         Int          @default(1) @map("max_periods_per_day")
  samePeriodAcrossWeek     Boolean      @default(false) @map("same_period_across_week")
  consecutiveBlockSize     Int          @default(1) @map("consecutive_block_size")
  consecutiveBlocksPerWeek Int?         @map("consecutive_blocks_per_week")
  /// §31.10 — may a consecutive block run through a break (one period either
  /// side of lunch, or across the short bell)? FALSE is every school today and
  /// stays the default. TRUE only ever WIDENS the domain: it permits a
  /// crossing, it never requires one.
  blockMayCrossBreak       Boolean      @default(false) @map("block_may_cross_break")
  schoolId                 Int          @map("school_id")
  school                   School       @relation(fields: [schoolId], references: [id])

  @@unique([classId, subjectId, academicYearId])
  @@index([academicYearId])
  @@index([schoolId])
  @@map("class_subjects")
}

model TeacherSubjectClassSection {
  id              Int          @id @default(autoincrement())
  teacherId       Int          @map("teacher_id")
  teacher         Teacher      @relation(fields: [teacherId], references: [id])
  subjectId       Int          @map("subject_id")
  subject         Subject      @relation(fields: [subjectId], references: [id])
  classSectionId  Int          @map("class_section_id")
  classSection    ClassSection @relation(fields: [classSectionId], references: [id], onDelete: Cascade)
  periodsPerWeek  Int          @map("periods_per_week")
  preferredRoomId Int?         @map("preferred_room_id")
  preferredRoom   Room?        @relation(fields: [preferredRoomId], references: [id])
  schoolId        Int          @map("school_id")
  school          School       @relation(fields: [schoolId], references: [id])

  @@unique([subjectId, classSectionId])
  @@index([schoolId])
  @@map("teacher_subject_class_section")
}

/// §30 Phase 43 — a pool's two modes.
///
/// `grouped` shares cohorts and staff capacity with the other timetables in the
/// pool; `individual` is a pool of one, calculated alone.
enum TimetableGroupMode {
  grouped
  individual
}

/// §30 Phase 43 — the pool a timetable draws its cohorts and its staff capacity
/// from.
///
/// Every school migrates to exactly one of these per session, which reproduces
/// today's behaviour precisely: one pool means invariant 11 ("a class-section
/// belongs to exactly one timetable_config") and Check 2's cross-config load
/// sum say exactly what they said before.
///
/// `individual` is a pool that holds ONE timetable and refuses a second. That
/// refusal is the whole of "an individual timetable cannot have more than one
/// wing" — checkable here, rather than a rule the Wings step has to remember.
model TimetableGroup {
  id             Int                @id @default(autoincrement())
  schoolId       Int                @map("school_id")
  school         School             @relation(fields: [schoolId], references: [id])
  /// Per session, because everything it scopes already is (§3.11).
  academicYearId Int                @map("academic_year_id")
  academicYear   AcademicYear       @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  name           String             @db.VarChar(60)
  mode           TimetableGroupMode @default(grouped)
  createdAt      DateTime           @default(now()) @map("created_at")
  configs        TimetableConfig[]
  classSections  ClassSection[]

  @@unique([schoolId, academicYearId, name], map: "uq_group_name")
  @@index([schoolId])
  @@index([academicYearId], map: "timetable_groups_year_idx")
  @@map("timetable_groups")
}

model TimetableConfig {
  id                          Int                   @id @default(autoincrement())
  schoolId                    Int                   @map("school_id")
  school                      School                @relation(fields: [schoolId], references: [id])
  academicYearId              Int                   @map("academic_year_id")
  academicYear                AcademicYear          @relation(fields: [academicYearId], references: [id])
  /// §30 — which pool this timetable competes for resources in.
  resourceGroupId             Int                   @map("resource_group_id")
  resourceGroup               TimetableGroup        @relation(fields: [resourceGroupId], references: [id])
  /// §30.5 — when this timetable applies. NULL at both ends means the whole
  /// session, which is every school before this feature; publishing then refuses
  /// a second live timetable over any class this one teaches.
  effectiveFrom               DateTime?             @map("effective_from") @db.Date
  effectiveTo                 DateTime?             @map("effective_to") @db.Date
  name                        String                @db.VarChar(50)
  description                 String?               @db.Text
  workingDays                 Json                  @map("working_days")
  periodsPerDay               Int                   @default(8) @map("periods_per_day")
  periodDurationMins          Int                   @default(40) @map("period_duration_mins")
  hasZeroPeriod               Boolean               @default(false) @map("has_zero_period")
  zeroPeriodDurationMins      Int?                  @map("zero_period_duration_mins")
  allowConsecutivePeriods     Boolean               @default(true) @map("allow_consecutive_periods")
  classTeacherGetsFirstPeriod Boolean               @default(false) @map("class_teacher_gets_first_period")
  startTime                   String                @default("08:00") @map("start_time") @db.VarChar(5)
  endTime                     String?               @map("end_time") @db.VarChar(5)
  /// §18: periods appended after the regular day for extra classes. The solver
  /// places only into 1..periodsPerDay, so these are a free space by
  /// construction rather than by a new rule.
  extraPeriodsPerDay          Int                   @default(0) @map("extra_periods_per_day")
  extraPeriodDurationMins     Int?                  @map("extra_period_duration_mins")
  /// Days that exist only for extra classes, e.g. [6] for Saturday. Kept apart
  /// from `workingDays` precisely so generation cannot reach them.
  extraDays                   Json?                 @map("extra_days")
  /// §28.1 — the percentage of a teacher's weekly limit at which the app says
  /// so. A WARNING threshold, never a blocker: a teacher at 80% is a normally
  /// employed teacher, and refusing to generate at a number a school chose for
  /// its own reporting would make most real schools ungenerable.
  loadAlertPct                Int                   @default(75) @map("load_alert_pct")
  status                      TimetableConfigStatus @default(draft)
  /// §29.1 — when this timetable was frozen, or NULL if it is not.
  ///
  /// A separate column rather than a `status` value: `status` already means
  /// draft/active/archived, and a second meaning on one column is how a field
  /// ends up unable to say "archived AND frozen". A timestamp also answers
  /// *when*, which is the first thing anybody asks of a change somebody else
  /// made. NULL is every timetable that exists today, so nothing changes until
  /// a school presses the button — freezing is a decision, never a side effect
  /// of publishing.
  frozenAt                    DateTime?             @map("frozen_at")
  /// Who froze it. No relation, matching `timetable_publications.published_by_id`:
  /// a record of who acted has to survive their account being removed.
  frozenById                  Int?                  @map("frozen_by_id")
  /// §29.2 — the staffing changes made against this timetable.
  staffingChanges             StaffingChange[]
  /// §32 — the subjects this timetable teaches. Empty = not stated = all.
  subjects                    TimetableSubject[]
  /// §33 — per-class lesson length, in base periods. Empty = not stated = 1.
  classSpans                  TimetableClassSpan[]
  periods                     Period[]
  classSections               ClassSection[]
  extraClasses                ExtraClass[]
  autoFixRuns                 AutoFixRun[]
  drafts                      TimetableDraft[]
  dailyActivities             DailyActivity[]

  @@unique([schoolId, name, academicYearId])
  @@index([resourceGroupId, effectiveFrom, effectiveTo], map: "tc_window_idx")
  @@map("timetable_config")
}

model Period {
  id                Int             @id @default(autoincrement())
  timetableConfigId Int             @map("timetable_config_id")
  timetableConfig   TimetableConfig @relation(fields: [timetableConfigId], references: [id], onDelete: Cascade)
  sortOrder         Int             @map("sort_order")
  periodNumber      Int?            @map("period_number")
  startTime         String          @map("start_time") @db.VarChar(5)
  endTime           String          @map("end_time") @db.VarChar(5)
  isBreak           Boolean         @default(false) @map("is_break")
  /// Part of the §18 extra-class window rather than the teaching day.
  isExtra           Boolean         @default(false) @map("is_extra")
  /// §28.3 — an assembly, attendance call or dispersal. A third band beside
  /// break and extra, rather than a flavour of break: a break is unstaffed by
  /// definition, and the whole point of an activity is that somebody is on duty.
  isActivity        Boolean         @default(false) @map("is_activity")
  activityId        Int?            @map("activity_id")
  activity          DailyActivity?  @relation(fields: [activityId], references: [id], onDelete: Cascade)
  breakName         String?         @map("break_name") @db.VarChar(30)
  schoolId          Int             @map("school_id")
  school            School          @relation(fields: [schoolId], references: [id])

  @@unique([timetableConfigId, sortOrder])
  @@index([schoolId])
  @@map("periods")
}

/// §28.3/28.4 — something that happens every day outside the teaching periods:
/// assembly, attendance, bus dispersal.
///
/// ONE table for both ends of the day, because an assembly and a dispersal
/// differ only in `placement`. Two tables would duplicate every rule about
/// duration, days and staffing so that the two could eventually disagree.
///
/// The load-bearing property is what is NOT here: an activity produces a period
/// row with `period_number = NULL`, outside `1..periodsPerDay`, so `domainFor`
/// cannot reach it — exactly as it cannot reach the §18 extra window. That is
/// what keeps the solver untouched. Widening the domain to include activities
/// would put a teacher on assembly duty into a slot `uq_teacher_slot` cannot
/// check, because that key compares period NUMBERS.
model DailyActivity {
  id                Int               @id @default(autoincrement())
  timetableConfigId Int               @map("timetable_config_id")
  timetableConfig   TimetableConfig   @relation(fields: [timetableConfigId], references: [id], onDelete: Cascade)
  name              String            @db.VarChar(60)
  placement         ActivityPlacement
  durationMins      Int               @map("duration_mins")
  /// ISO day numbers it runs on. Assembly on Monday only is ordinary.
  days              Json
  /// Who is on duty, and where. Both nullable, and null means "not stated"
  /// rather than "nobody" — the same reading §18 gives an empty scope.
  teacherId         Int?              @map("teacher_id")
  teacher           Teacher?          @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  roomId            Int?              @map("room_id")
  room              Room?             @relation(fields: [roomId], references: [id], onDelete: SetNull)
  sortOrder         Int               @default(0) @map("sort_order")
  isActive          Boolean           @default(true) @map("is_active")
  schoolId          Int               @map("school_id")
  school            School            @relation(fields: [schoolId], references: [id])
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  periods           Period[]

  @@unique([timetableConfigId, name], map: "uq_activity_name")
  @@index([schoolId])
  @@index([timetableConfigId])
  @@map("daily_activities")
}

enum ActivityPlacement {
  before_first
  after_last
}

/// §27.13 — the subjects a teacher teaches, DECLARED rather than derived.
///
/// It was never stored: the guided setup asked, used the answer to propose
/// mappings, and threw it away, so the only trace was whatever
/// `teacher_subject_class_section` rows happened to exist. A school setting up
/// its second wing therefore met an empty "Teaches" column for staff whose
/// subjects it had entered an hour earlier.
///
/// Derived-from-mappings is the mistake §18 already corrected once:
/// `teacher_class_eligibility` is declared for the same reason — a fact read
/// back from existing mappings can only describe what somebody has ALREADY been
/// given, and can never constrain what they are given next.
///
/// **Absent means "not stated", never "teaches nothing"** (invariant 7). Every
/// school predating this has no rows, and readers fall back to what the
/// mappings imply, so nothing changes until somebody says something.
model TeacherSubject {
  teacherId Int     @map("teacher_id")
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subjectId Int     @map("subject_id")
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  schoolId  Int     @map("school_id")
  school    School  @relation(fields: [schoolId], references: [id])

  @@id([teacherId, subjectId])
  @@index([schoolId])
  @@index([subjectId])
  @@map("teacher_subjects")
}

model Holiday {
  id             Int          @id @default(autoincrement())
  academicYearId Int          @map("academic_year_id")
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  date           DateTime     @db.Date
  name           String       @db.VarChar(100)
  schoolId       Int          @map("school_id")
  school         School       @relation(fields: [schoolId], references: [id])

  @@index([schoolId])
  @@map("holidays")
}

model MergedTeachingGroup {
  id                   Int                         @id @default(autoincrement())
  schoolId             Int                         @map("school_id")
  school               School                      @relation(fields: [schoolId], references: [id])
  subjectId            Int                         @map("subject_id")
  subject              Subject                     @relation(fields: [subjectId], references: [id])
  teacherId            Int                         @map("teacher_id")
  teacher              Teacher                     @relation(fields: [teacherId], references: [id])
  periodsPerWeek       Int                         @map("periods_per_week")
  roomId               Int?                        @map("room_id")
  room                 Room?                       @relation(fields: [roomId], references: [id])
  consecutiveBlockSize Int                         @default(1) @map("consecutive_block_size")
  members              MergedTeachingGroupMember[]

  @@map("merged_teaching_groups")
}

model MergedTeachingGroupMember {
  mergedGroupId  Int                 @map("merged_group_id")
  mergedGroup    MergedTeachingGroup @relation(fields: [mergedGroupId], references: [id], onDelete: Cascade)
  classSectionId Int                 @map("class_section_id")
  classSection   ClassSection        @relation(fields: [classSectionId], references: [id])
  schoolId       Int                 @map("school_id")
  school         School              @relation(fields: [schoolId], references: [id])

  @@id([mergedGroupId, classSectionId])
  @@index([schoolId])
  @@map("merged_teaching_group_members")
}

model ElectiveBlock {
  id               Int                   @id @default(autoincrement())
  schoolId         Int                   @map("school_id")
  school           School                @relation(fields: [schoolId], references: [id])
  name             String                @db.VarChar(50)
  periodsPerWeek   Int                   @map("periods_per_week")
  /// Occurrences of this block allowed on one day. 1 = the usual "one language
  /// period a day"; without it a 5-period block could stack on Monday.
  maxPeriodsPerDay Int                   @default(1) @map("max_periods_per_day")
  /// §4.9 Phase 15 — when the block runs. `solver` lets it float (the default,
  /// so no existing block changes behaviour); `same_period` holds it to one
  /// period number across its days; `fixed` pins exact cells. All three are
  /// enforced by pruning the solver's domain, never by penalty scoring.
  placement        ElectivePlacement     @default(solver)
  /// Read only when placement = `fixed`: [{ day, period }, …], one per
  /// occurrence. Kept as JSON rather than rows because it is a small ordered
  /// list edited as a whole, never queried across blocks.
  fixedSlots       Json?                 @map("fixed_slots")
  members          ElectiveBlockMember[]
  options          ElectiveOption[]

  @@map("elective_blocks")
}

model ElectiveBlockMember {
  electiveBlockId Int           @map("elective_block_id")
  electiveBlock   ElectiveBlock @relation(fields: [electiveBlockId], references: [id], onDelete: Cascade)
  classSectionId  Int           @map("class_section_id")
  classSection    ClassSection  @relation(fields: [classSectionId], references: [id])
  schoolId        Int           @map("school_id")
  school          School        @relation(fields: [schoolId], references: [id])

  @@id([electiveBlockId, classSectionId])
  @@index([schoolId])
  @@map("elective_block_members")
}

model ElectiveOption {
  id              Int           @id @default(autoincrement())
  electiveBlockId Int           @map("elective_block_id")
  electiveBlock   ElectiveBlock @relation(fields: [electiveBlockId], references: [id], onDelete: Cascade)
  subjectId       Int           @map("subject_id")
  subject         Subject       @relation(fields: [subjectId], references: [id])
  teacherId       Int           @map("teacher_id")
  teacher         Teacher       @relation(fields: [teacherId], references: [id])
  roomId          Int           @map("room_id")
  room            Room          @relation(fields: [roomId], references: [id])
  schoolId        Int           @map("school_id")
  school          School        @relation(fields: [schoolId], references: [id])

  @@index([schoolId])
  @@map("elective_options")
}

/// §18 — an extra or guest class: the standing arrangement, plus the
/// `timetable_slots` row (source `extra`) that actually reserves the cell.
/// Two rows for one thing on purpose: the slot is what the unique keys guard
/// and what every grid already reads, while the reason and the dates it runs
/// between belong nowhere near the hottest table in the schema.
model ExtraClass {
  id                Int             @id @default(autoincrement())
  schoolId          Int             @map("school_id")
  school            School          @relation(fields: [schoolId], references: [id])
  timetableConfigId Int             @map("timetable_config_id")
  timetableConfig   TimetableConfig @relation(fields: [timetableConfigId], references: [id], onDelete: Cascade)
  /// §25 — an extra class is outside every draft but NOT outside a term: a
  /// Saturday revision class runs in the term it was arranged for.
  termId            Int?            @map("term_id")
  term              AcademicTerm?   @relation(fields: [termId], references: [id])
  termScope         Int             @default(dbgenerated()) @map("term_scope")
  classSectionId    Int             @map("class_section_id")
  classSection      ClassSection    @relation(fields: [classSectionId], references: [id], onDelete: Cascade)
  subjectId         Int             @map("subject_id")
  subject           Subject         @relation(fields: [subjectId], references: [id])
  teacherId         Int             @map("teacher_id")
  teacher           Teacher         @relation(fields: [teacherId], references: [id])
  roomId            Int?            @map("room_id")
  room              Room?           @relation(fields: [roomId], references: [id])
  dayOfWeek         Int             @map("day_of_week") @db.TinyInt
  periodNumber      Int             @map("period_number")
  reason            String?         @db.VarChar(160)
  /// The window it runs between. Advisory — the slot itself is weekly.
  effectiveFrom     DateTime?       @map("effective_from") @db.Date
  effectiveTo       DateTime?       @map("effective_to") @db.Date
  createdBy         Int?            @map("created_by")
  createdAt         DateTime        @default(now()) @map("created_at")

  @@unique([timetableConfigId, termScope, classSectionId, dayOfWeek, periodNumber], map: "uq_extra_class_cell")
  @@index([schoolId])
  @@map("extra_classes")
}

model AuditLog {
  id        BigInt   @id @default(autoincrement())
  schoolId  Int      @map("school_id")
  school    School   @relation(fields: [schoolId], references: [id])
  userId    Int      @map("user_id")
  action    String   @db.VarChar(80)
  detail    Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("audit_log")
}

// ===================== PHASE 2: THE TIMETABLE ITSELF (§3, §4.9) =====================

/// §22 Phase 17 — the named drafts of one timetable config.
///
/// A school does not generate once and publish. They generate, look, tweak the
/// masters, generate again, hand-edit one, and only then decide which of the
/// three the school will live with. This row is what makes that comparison a
/// reading rather than a recollection.
model TimetableDraft {
  id                Int             @id @default(autoincrement())
  schoolId          Int             @map("school_id")
  school            School          @relation(fields: [schoolId], references: [id])
  timetableConfigId Int             @map("timetable_config_id")
  timetableConfig   TimetableConfig @relation(fields: [timetableConfigId], references: [id], onDelete: Cascade)
  /// §25 — a draft belongs to ONE term. A draft spanning every term would make
  /// its §22.3 stats ("87% generated, 4 errors") a number about several
  /// different timetables at once, which is not a number. NULL = year-wise.
  termId            Int?            @map("term_id")
  term              AcademicTerm?   @relation(fields: [termId], references: [id])
  /// Generated: `COALESCE(term_id, 0)`. In `uq_draft_no` so each term counts
  /// its own drafts from #1, and the five-live limit is per term.
  termScope         Int             @default(dbgenerated()) @map("term_scope")
  /// per-config sequence — what the school calls it: "Draft #2"
  draftNo           Int             @map("draft_no") @db.SmallInt
  label             String?         @db.VarChar(80)
  status            DraftStatus     @default(draft)
  /// §22.3 stats, stamped by one owner and READ from here — the Draft Board
  /// never counts 2,000 slots per render (§14).
  requiredLessons   Int?            @map("required_lessons")
  placedLessons     Int?            @map("placed_lessons")
  generationPct     Decimal?        @map("generation_pct") @db.Decimal(5, 2)
  errorCount        Int?            @map("error_count")
  warningCount      Int?            @map("warning_count")
  lockedCount       Int?            @map("locked_count")
  manualCount       Int?            @map("manual_count")
  solverStats       Json?           @map("solver_stats")
  generatedAt       DateTime?       @map("generated_at")
  createdById       Int?            @map("created_by")
  createdAt         DateTime        @default(now()) @map("created_at")
  publishedAt       DateTime?       @map("published_at")
  publishedById     Int?            @map("published_by")
  slots             TimetableSlot[]

  @@unique([schoolId, timetableConfigId, termScope, draftNo], map: "uq_draft_no")
  @@index([schoolId])
  @@index([timetableConfigId, status])
  @@map("timetable_drafts")
}

enum DraftStatus {
  draft
  published
  archived
  discarded
}

enum SlotStatus {
  draft
  published
}

enum SlotSource {
  auto
  manual
  substitute
  /// §18 extra/guest class. Lives in the same table so the three unique keys
  /// still refuse a double-booked teacher or room, but occupies the config's
  /// *extra* window, which the solver never places into.
  extra
}

// One row per (class-section, day, period). Merged groups (§4.9) produce one
// row per member section, but ONLY the primary row carries teacher_occupancy_key
// and room_id — echo rows keep them NULL so the unique keys below stay the
// absolute DB-level guarantee: a teacher/room can hold one occupancy event per
// (config, status, day, period), while a merged group legitimately spans
// several sections. The occupancy key is written by the single slot-writer
// service (T-{teacherId} / MG-{groupId}), never by callers.
model TimetableSlot {
  id                  BigInt          @id @default(autoincrement())
  timetableConfigId   Int             @map("timetable_config_id")
  status              SlotStatus      @default(draft)
  /// §22 — which named draft this row belongs to. NULL on published rows that
  /// pre-date Phase 17 and on `source='extra'` rows, which live once per
  /// config outside any draft (§18).
  draftId             Int?            @map("draft_id")
  draft               TimetableDraft? @relation(fields: [draftId], references: [id])
  /// §22 — a STORED GENERATED column in MySQL: `0` for published and extra
  /// rows, `draft_id` otherwise. It exists solely to sit inside the three
  /// unique keys below, collapsing them where the double-booking guarantee has
  /// to stay global.
  ///
  /// `dbgenerated()`, NOT `@default(0)`: Prisma applies a literal default
  /// CLIENT-side and sends the column in the INSERT, which MySQL rejects
  /// outright ("The value specified for generated column 'draft_scope' ... is
  /// not allowed"). This annotation is what tells Prisma the database owns it.
  draftScope          Int             @default(dbgenerated()) @map("draft_scope")
  /// §25 — which term of the session this row belongs to. NULL means the whole
  /// year, which is every row a year-wise school has ever written.
  termId              Int?            @map("term_id")
  term                AcademicTerm?   @relation(fields: [termId], references: [id])
  /// §25 — a STORED GENERATED column: `COALESCE(term_id, 0)`. Like
  /// `draft_scope`, it exists solely to sit inside the three unique keys, where
  /// a NULL would be treated as distinct and would quietly let two year-wide
  /// rows share one cell. Never written from code — see `draftScope` above for
  /// why `dbgenerated()` rather than a default.
  termScope           Int             @default(dbgenerated()) @map("term_scope")
  /// NULL only on a §4.9 elective *option* row, which belongs to a block
  /// rather than to any one section — there is no enrolment model, so an
  /// option genuinely has no class-section. NULL also takes the row out of
  /// `uq_class_slot`, which is what lets several parallel lessons share one
  /// slot while every member section keeps exactly one guarded cell.
  classSectionId      Int?            @map("class_section_id")
  dayOfWeek           Int             @map("day_of_week") @db.TinyInt
  periodNumber        Int             @map("period_number")
  subjectId           Int?            @map("subject_id")
  teacherId           Int?            @map("teacher_id")
  roomId              Int?            @map("room_id")
  mergedGroupId       Int?            @map("merged_group_id")
  /// §4.9 split electives. Set on both the member rows (the shared cell each
  /// section sees) and the option rows (the parallel lessons underneath).
  electiveBlockId     Int?            @map("elective_block_id")
  /// Set on option rows only — which parallel lesson this row is.
  electiveOptionId    Int?            @map("elective_option_id")
  teacherOccupancyKey String?         @map("teacher_occupancy_key") @db.VarChar(30)
  isLocked            Boolean         @default(false) @map("is_locked")
  source              SlotSource      @default(auto)
  schoolId            Int             @map("school_id")
  school              School          @relation(fields: [schoolId], references: [id])

  @@unique([timetableConfigId, status, draftScope, termScope, classSectionId, dayOfWeek, periodNumber], map: "uq_class_slot")
  @@unique([timetableConfigId, status, draftScope, termScope, teacherOccupancyKey, dayOfWeek, periodNumber], map: "uq_teacher_slot")
  @@unique([timetableConfigId, status, draftScope, termScope, roomId, dayOfWeek, periodNumber], map: "uq_room_slot")
  @@index([timetableConfigId, status, teacherId])
  // Scoped reads are always `school_id = ? AND timetable_config_id = ? AND
  // status = ?` — this is the index EXPLAIN must pick for the matrix and board
  // queries, the hottest path in the app (§14).
  @@index([schoolId, timetableConfigId, status])
  @@index([schoolId, timetableConfigId, status, draftId])
  @@index([schoolId, timetableConfigId, status, termId])
  @@map("timetable_slots")
}

// Publish audit trail (§7 / task 3.7): one row per publish event, so the
// Publish Confirmation screen can show "v13 → v14" and effective-since dates.
// The slots themselves flip status inside the same transaction that writes
// this row — the version number is derived from this log, never stored on slots.
model TimetablePublication {
  id                Int           @id @default(autoincrement())
  timetableConfigId Int           @map("timetable_config_id")
  /// §25 — each term publishes on its own and keeps its own history, so each
  /// has a version 1. Publishing Term 3 in November must not renumber Term 1.
  termId            Int?          @map("term_id")
  term              AcademicTerm? @relation(fields: [termId], references: [id])
  termScope         Int           @default(dbgenerated()) @map("term_scope")
  version           Int
  slotCount         Int           @map("slot_count")
  changedCount      Int           @map("changed_count")
  unallocatedCount  Int           @map("unallocated_count")
  publishedById     Int?          @map("published_by_id")
  publishedAt       DateTime      @default(now()) @map("published_at")
  /// §3.14 — set when this version was withdrawn back into a draft. The row is
  /// KEPT: deleting it would make v3 disappear and renumber the next publish to
  /// v3, quietly changing the school's own record of what was on the wall.
  withdrawnAt       DateTime?     @map("withdrawn_at")
  withdrawnById     Int?          @map("withdrawn_by_id")
  schoolId          Int           @map("school_id")
  school            School        @relation(fields: [schoolId], references: [id])

  @@unique([timetableConfigId, termScope, version], map: "uq_config_version")
  @@index([schoolId])
  @@index([timetableConfigId, withdrawnAt], map: "tp_live_idx")
  @@map("timetable_publications")
}

// ===== Phase 4 — Substitute Teacher Engine (§6) =====

enum AbsenceStatus {
  reported
  substitutes_assigned
  resolved
}

model TeacherAbsence {
  id        Int           @id @default(autoincrement())
  teacherId Int           @map("teacher_id")
  teacher   Teacher       @relation(fields: [teacherId], references: [id])
  date      DateTime      @db.Date
  reason    String?       @db.VarChar(100)
  status    AbsenceStatus @default(reported)
  createdAt DateTime      @default(now()) @map("created_at")
  schoolId  Int           @map("school_id")
  school    School        @relation(fields: [schoolId], references: [id])

  substitutions SubstitutionLog[]

  @@unique([teacherId, date], map: "uq_teacher_absence_date")
  @@index([schoolId])
  @@map("teacher_absences")
}

// Date-specific overlay (§6.2, invariant 4): the base published timetable is
// NEVER mutated. One row = "on {date}, {substitute} covers {slot} instead of
// {original}". Views layer these over the published grid at read time — the
// literal §6.2 "insert substitute rows into timetable_slots" would collide
// with the §3 unique keys (no date column there), so the overlay lives here.
model SubstitutionLog {
  id                  Int            @id @default(autoincrement())
  timetableSlotId     BigInt         @map("timetable_slot_id")
  absenceId           Int            @map("absence_id")
  absence             TeacherAbsence @relation(fields: [absenceId], references: [id], onDelete: Cascade)
  originalTeacherId   Int            @map("original_teacher_id")
  substituteTeacherId Int            @map("substitute_teacher_id")
  date                DateTime       @db.Date
  reason              String?        @db.VarChar(100)
  createdById         Int?           @map("created_by")
  createdAt           DateTime       @default(now()) @map("created_at")
  schoolId            Int            @map("school_id")
  school              School         @relation(fields: [schoolId], references: [id])

  @@unique([timetableSlotId, date], map: "uq_slot_substitution_date")
  @@index([date, substituteTeacherId])
  @@index([schoolId])
  @@map("substitution_log")
}

// ===== Phase 5 — Notifications (§9) =====
model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   @db.VarChar(40)
  title     String   @db.VarChar(160)
  body      String   @db.VarChar(500)
  link      String?  @db.VarChar(120)
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")
  schoolId  Int      @map("school_id")
  school    School   @relation(fields: [schoolId], references: [id])

  @@index([userId, isRead, createdAt])
  @@index([schoolId])
  @@map("notifications")
}

// ===== Phase 7 — AI Assistant (§13.2) =====

enum AiProvider {
  anthropic
  openai
  google
  azure_openai
}

enum AiChatRole {
  user
  assistant
  tool
}

/// One row per school. The API key is AES-256-GCM encrypted at rest and is
/// write-only in the UI — it is never selected into a response or a log line.
model AiSettings {
  id                 Int        @id @default(autoincrement())
  schoolId           Int        @unique @map("school_id")
  school             School     @relation(fields: [schoolId], references: [id])
  provider           AiProvider @default(anthropic)
  model              String     @default("claude-opus-5") @db.VarChar(60)
  apiKeyEncrypted    Bytes?     @map("api_key_encrypted") @db.VarBinary(512)
  apiBaseUrl         String?    @map("api_base_url") @db.VarChar(255)
  monthlyTokenBudget Int?       @map("monthly_token_budget")
  /// {"chat":true,"reports":true,"nl_data_entry":false,"conflict_explain":true}
  features           Json?
  isActive           Boolean    @default(true) @map("is_active")
  updatedById        Int?       @map("updated_by")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  @@map("ai_settings")
}

/// Full audit trail (§13.2, required): every turn of every conversation with
/// the tools it ran and the tokens it cost. Drives the usage meter and budget.
model AiChatLog {
  id             BigInt     @id @default(autoincrement())
  schoolId       Int        @map("school_id")
  school         School     @relation(fields: [schoolId], references: [id])
  userId         Int        @map("user_id")
  conversationId String     @map("conversation_id") @db.Char(36)
  role           AiChatRole
  content        String?    @db.MediumText
  /// which tools ran, with the SCOPED arguments they actually executed with
  toolsCalled    Json?      @map("tools_called")
  inputTokens    Int        @default(0) @map("input_tokens")
  outputTokens   Int        @default(0) @map("output_tokens")
  createdAt      DateTime   @default(now()) @map("created_at")

  @@index([schoolId, createdAt])
  @@index([conversationId, id])
  @@map("ai_chat_log")
}

/// §21 (Phase 14.1) — one press of Auto-resolve on the Readiness Dashboard.
///
/// Records what each field held *before* the run, which is what makes "Undo
/// this run" possible and what makes the button safe to press in the first
/// place. `changes` and `outcomes` are the shared package's own shapes; see
/// the migration for why they are JSON rather than child tables.
model AutoFixRun {
  id                Int             @id @default(autoincrement())
  schoolId          Int             @map("school_id")
  school            School          @relation(fields: [schoolId], references: [id])
  timetableConfigId Int             @map("timetable_config_id")
  config            TimetableConfig @relation(fields: [timetableConfigId], references: [id], onDelete: Cascade)
  appliedById       Int?            @map("applied_by_id")
  scoreBefore       Int             @map("score_before")
  scoreAfter        Int             @map("score_after")
  changes           Json
  outcomes          Json
  undoneAt          DateTime?       @map("undone_at")
  createdAt         DateTime        @default(now()) @map("created_at")

  @@index([schoolId, timetableConfigId])
  @@map("auto_fix_runs")
}

// ===================== PHASE 23 (§23.7): ERP SYNC HISTORY =====================

/// One row per master, per sync run — the answer to "what did that button do?".
///
/// A sync is the one screen in the app that deletes other people's work, and it
/// runs unattended in the sense that nobody watches the writes. So every run is
/// recorded whatever happens: the rows counted, the rows written, the endpoint
/// called, and — on a failure — the ERP's own error text. A failed run is
/// logged as loudly as a successful one, because "we synced and nothing changed"
/// and "the sync could not reach the ERP" look identical from the outside and
/// have completely different remedies.
///
/// `detail` carries the per-row summary the screen expands, and on a destructive
/// run the impact the admin actually consented to — so a question six weeks
/// later about a missing teacher has an answer.
model ErpSyncRun {
  id         Int      @id @default(autoincrement())
  schoolId   Int      @map("school_id")
  school     School   @relation(fields: [schoolId], references: [id])
  /// the master, as `SyncSheet` spells it: "Teachers", "Class Sections", …
  sheet      String   @db.VarChar(40)
  /// `refresh` (key-preserving) or `replace` (delete and re-insert)
  mode       String   @db.VarChar(10)
  /// `ok` · `failed` · `blocked` (refused before writing anything)
  status     String   @db.VarChar(10)
  /// the ERP path this run called, so a wrong mapping is visible in the history
  endpoint   String?  @db.VarChar(255)
  fetched    Int      @default(0)
  created    Int      @default(0)
  updated    Int      @default(0)
  deleted    Int      @default(0)
  durationMs Int      @map("duration_ms")
  error      String?  @db.Text
  detail     Json?
  runById    Int?     @map("run_by_id")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([schoolId, sheet])
  @@index([schoolId, createdAt])
  @@map("erp_sync_runs")
}

/// §15.3 Phase 25.2 — a guided setup in progress.
///
/// Eleven steps is more than one sitting for a real school, so the answers live
/// on the server from the first Next. Losing twenty minutes of typing to a
/// refresh is the failure that would sink the feature — people do not start
/// again, they go and do something else.
///
/// **Nothing here is committed data.** `answers` is what somebody has typed so
/// far; the actual rows are written at the end, through the endpoints that
/// already exist (§16's validated pipeline). That separation is what lets a
/// half-finished wizard leave no trace in `classes`, `rooms` or anywhere else.
///
/// Keyed by (school, user) rather than by school alone: two admins setting up
/// the same school get their own drafts instead of overwriting each other's
/// half-typed answers. A shared draft would need conflict resolution nobody
/// asked for.
model OnboardingSession {
  id       Int    @id @default(autoincrement())
  schoolId Int    @map("school_id")
  school   School @relation(fields: [schoolId], references: [id])
  userId   Int    @map("user_id")

  /// Which door they came through. The AI interviewer (25.5) writes into the
  /// SAME row as the step-by-step wizard, so switching keeps everything.
  mode        OnboardingMode @default(wizard)
  /// 1-based, matching the step numbers people see.
  currentStep Int            @default(1) @map("current_step")
  /// Everything typed so far, by step. Deliberately opaque to the database:
  /// the shape belongs to the wizard, and a column per field would mean a
  /// migration every time a step gained one.
  answers     Json?

  completedAt DateTime? @map("completed_at")
  /// Where THIS run of the conversation begins in `ai_chat_log` (§24.6).
  ///
  /// The transcript is not copied here — it is read from the audit log, which
  /// is the record that already exists and can be checked. But the log is never
  /// deleted: the monthly AI token budget is summed from it, so clearing a
  /// conversation would refund the tokens it cost, and spend-discard-repeat
  /// would make the cap meaningless. So a fresh setup moves this marker instead,
  /// and everything before it stays as history without appearing on screen or
  /// in what the model is told it said.
  chatSince   DateTime? @map("chat_since")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([schoolId, userId])
  @@index([schoolId])
  @@map("onboarding_sessions")
}

enum OnboardingMode {
  wizard
  ai
}

// ============== PHASE 39 (§29.2): STAFFING CHANGES ON A SETTLED TIMETABLE ==============

enum StaffingChangeReason {
  resigned
  leave
  joined
  adjustment
}

enum StaffingChangeStatus {
  planning
  applied
  reverted
}

enum StaffingRole {
  releasing
  receiving
}

enum StaffingUnitType {
  mapping
  merged_group
  elective_option
  class_teacher
}

/// §29.2 — a teacher's classes moving, on a timetable that is otherwise settled.
///
/// The scoped thaw of §29.1, and deliberately a RECORD rather than a mode. A
/// mode that is switched on and off cannot answer "who taught Class 5-A Maths
/// before September, and why did it move?", which is a question a school asks.
///
/// It is also the only thing allowed to write while a timetable is frozen: the
/// ordinary routes stay refused, because the point of §29 is that re-staffing
/// is a decided, validated, reversible act rather than twenty free-hand edits.
model StaffingChange {
  id                Int                  @id @default(autoincrement())
  timetableConfigId Int                  @map("timetable_config_id")
  config            TimetableConfig      @relation(fields: [timetableConfigId], references: [id], onDelete: Cascade)
  /// An enum, not free text: the reason chooses the default SHAPE of the change
  /// (a resignation releases everything a teacher holds; an adjustment releases
  /// what somebody picks), and free text cannot drive that. `note` is where the
  /// school's own sentence goes.
  reason            StaffingChangeReason
  status            StaffingChangeStatus @default(planning)
  /// Recorded, never acted on. A change takes effect when somebody applies it;
  /// a timetable that rewrote itself overnight on a stored date is exactly the
  /// behaviour §29 was asked not to have.
  effectiveFrom     DateTime?            @map("effective_from") @db.Date
  note              String?              @db.VarChar(200)
  createdById       Int?                 @map("created_by_id")
  createdAt         DateTime             @default(now()) @map("created_at")
  appliedById       Int?                 @map("applied_by_id")
  appliedAt         DateTime?            @map("applied_at")
  revertedAt        DateTime?            @map("reverted_at")
  schoolId          Int                  @map("school_id")
  school            School               @relation(fields: [schoolId], references: [id])

  teachers StaffingChangeTeacher[]
  items    StaffingChangeItem[]

  @@index([schoolId])
  @@index([timetableConfigId, status])
  @@map("staffing_changes")
}

/// Which teachers a change concerns, and on which side.
///
/// A teacher is `releasing` or `receiving`, never both — which is what the
/// composite primary key enforces. Both at once is not a shape the engine can
/// score: a candidate must have a settled load before anything is offered to
/// them, and a teacher simultaneously losing and gaining has two answers to
/// "how full are they?".
model StaffingChangeTeacher {
  changeId  Int            @map("change_id")
  change    StaffingChange @relation(fields: [changeId], references: [id], onDelete: Cascade)
  teacherId Int            @map("teacher_id")
  teacher   Teacher        @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  role      StaffingRole
  schoolId  Int            @map("school_id")
  school    School         @relation(fields: [schoolId], references: [id])

  @@id([changeId, teacherId])
  @@index([schoolId])
  @@index([teacherId])
  @@map("staffing_change_teachers")
}

/// What actually moved — the undo record, written by §29.4's apply.
///
/// A real table rather than `auto_fix_runs`-style JSON, and that precedent is
/// close enough to be worth answering: an auto-fix change is a heterogeneous
/// field-set replayed only as a unit, whereas every row here is the SAME fact —
/// this unit moved from teacher X to teacher Y — and it answers a standing
/// question that JSON cannot index.
///
/// `unitId` is polymorphic and has NO foreign key. §4.7b argues against that
/// for LIVE rows and is right; this is history, and an FK would erase the
/// record when its mapping is deleted — which is exactly the case you most want
/// the record for. `label` is denormalised for the same reason: the row has to
/// survive its subject, and a join cannot.
model StaffingChangeItem {
  id            Int              @id @default(autoincrement())
  changeId      Int              @map("change_id")
  change        StaffingChange   @relation(fields: [changeId], references: [id], onDelete: Cascade)
  unitType      StaffingUnitType @map("unit_type")
  unitId        Int              @map("unit_id")
  label         String           @db.VarChar(120)
  fromTeacherId Int?             @map("from_teacher_id")
  toTeacherId   Int?             @map("to_teacher_id")
  slotCount     Int              @default(0) @map("slot_count")
  schoolId      Int              @map("school_id")
  school        School           @relation(fields: [schoolId], references: [id])

  @@unique([changeId, unitType, unitId], map: "uq_change_unit")
  @@index([schoolId])
  @@map("staffing_change_items")
}
