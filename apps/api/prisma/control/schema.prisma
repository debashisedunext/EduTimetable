// ============================ THE CONTROL PLANE (§17.3, Phase 9.2) ============================
//
// The tenant registry: which schools exist, which ERP signed their users in,
// and — for schools that have their own database — how to reach it.
//
// WHY THIS IS A SEPARATE DATABASE, not extra tables in the app schema:
//
//   1. Chicken and egg. Under `dedicated` mode the registry cannot live inside
//      a tenant database, because you need the registry to *find* that
//      database. It has to be reachable from a single boot-time env var.
//   2. Prisma cannot host two migration histories in one database — both
//      schemas would write `_prisma_migrations` and each would read the
//      other's rows as drift.
//
// This is a deviation from the Phase 9 plan, which said the control plane would
// default to living in the app database; the reasons above only became clear
// during implementation and are recorded in §17.3. The cost is nil in practice:
// it is a second schema on the *same* MySQL server (CONTROL_DATABASE_URL
// defaults alongside DATABASE_URL), so a single-school install still needs no
// new container, credentials or operator action.
//
// Nothing here is school-scoped — this schema is *about* schools — so the 9.1
// scoping extension is deliberately not applied to this client.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/control-client"
}

datasource db {
  provider = "mysql"
  url      = env("CONTROL_DATABASE_URL")
}

enum TenantMode {
  /// Rows live in the shared application database, separated by school_id.
  /// A trust group's schools share one database this way.
  shared
  /// This school has its own database and its own credentials.
  dedicated
}

enum TenantStatus {
  provisioning
  active
  suspended
}

/// One Edunext ERP installation. Different installations sign their SSO tokens
/// with different keys, so a single global ERP_PUBLIC_KEY (the pre-9.2 model)
/// cannot serve more than one — and, worse, would let any ERP mint a token for
/// any school. The key is selected per instance by the token's `kid`/`iss`
/// (§17.3), which is what confines an ERP to its own schools.
model ErpInstance {
  id           Int      @id @default(autoincrement())
  /// human label, e.g. "Edunext Cloud (IN)"
  name         String   @db.VarChar(120)
  /// JWT `iss` claim this installation stamps, when it sets one
  issuer       String?  @db.VarChar(160)
  /// JWT header `kid` — the primary way a token selects its verification key
  kid          String?  @unique @db.VarChar(80)
  publicKeyPem String   @map("public_key_pem") @db.Text
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  tenants       Tenant[]
  trusts        Trust[]
  platformUsers PlatformUser[]

  @@map("erp_instances")
}

/// A group of schools under one management body. Scenario 2 of §17: the trust
/// shares a database and its schools are separated by school_id. Optional — a
/// standalone school has no trust.
model Trust {
  id            Int         @id @default(autoincrement())
  erpInstanceId Int         @map("erp_instance_id")
  erpInstance   ErpInstance @relation(fields: [erpInstanceId], references: [id])
  name          String      @db.VarChar(120)
  /// stable identifier from the ERP, unique within the installation
  code          String      @db.VarChar(40)
  isActive      Boolean     @default(true) @map("is_active")
  createdAt     DateTime    @default(now()) @map("created_at")

  tenants Tenant[]

  @@unique([erpInstanceId, code])
  @@map("trusts")
}

/// One school, as the platform sees it from outside any database.
///
/// This is the row that answers "an SSO token arrived claiming ERP instance X,
/// school code Y — which database, and which school_id inside it?".
model Tenant {
  id            Int         @id @default(autoincrement())
  erpInstanceId Int         @map("erp_instance_id")
  erpInstance   ErpInstance @relation(fields: [erpInstanceId], references: [id])
  trustId       Int?        @map("trust_id")
  trust         Trust?      @relation(fields: [trustId], references: [id])

  /// The ERP's stable code for this school. Together with the installation it
  /// is the only identifier meaningful across databases — a numeric id is not,
  /// since ids repeat between them.
  schoolCode  String @map("school_code") @db.VarChar(40)
  displayName String @map("display_name") @db.VarChar(120)

  mode TenantMode @default(shared)

  /// Connection URL for `dedicated` schools, AES-256-GCM encrypted at rest with
  /// the same custody as AI provider keys (§13.2): never selected into a
  /// response, never logged. NULL for `shared` schools, which use the
  /// application's own DATABASE_URL.
  dbUrlEncrypted Bytes? @map("db_url_encrypted") @db.VarBinary(1024)

  /// The `schools.id` this tenant maps to *inside* its database. For a
  /// dedicated school this is usually 1; for a shared one it is that school's
  /// row in the shared database.
  localSchoolId Int @map("local_school_id")

  /// Last migration applied to this tenant's database. The API refuses to serve
  /// a tenant whose schema is behind the application, failing loudly at the
  /// door rather than crashing mid-query (§17.3, task 9.3).
  schemaVersion String? @map("schema_version") @db.VarChar(80)

  status    TenantStatus @default(active)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  @@unique([erpInstanceId, schoolCode])
  @@index([trustId])
  @@map("tenants")
}

/// Who may administer the platform itself (§17.6, Phase 9.8).
///
/// This table exists in the control plane, not in any school's database,
/// because of a containment rule: a school's own Super Admin manages that
/// school's roles, and must not be able to grant themselves authority over the
/// registry — over other schools' status, connections or existence. Those are
/// different jobs at different levels, and a permission granted inside a tenant
/// can never reach outside it.
///
/// Identity is the ERP's, since that is the only identity that survives across
/// schools: the same person is a different `users` row in every school they
/// work in. Bootstrapping is deliberately a command, not a screen — the first
/// platform admin cannot be granted through a UI that requires being one.
model PlatformUser {
  id            Int         @id @default(autoincrement())
  erpInstanceId Int         @map("erp_instance_id")
  erpInstance   ErpInstance @relation(fields: [erpInstanceId], references: [id])
  /// matches SessionTokenPayload.erpUserId
  erpUserId     String      @map("erp_user_id") @db.VarChar(50)
  /// for display in the console only; never used to authorise
  name          String?     @db.VarChar(100)
  email         String?     @db.VarChar(120)
  isActive      Boolean     @default(true) @map("is_active")
  createdAt     DateTime    @default(now()) @map("created_at")
  lastSeenAt    DateTime?   @map("last_seen_at")

  @@unique([erpInstanceId, erpUserId])
  @@map("platform_users")
}

// ═══════════════════ SELF-SERVE ACCOUNTS (§15.3, Phase 25.0) ═══════════════════
//
// Until Phase 25 there was no local login at all: the ERP owned every
// credential and this app only ever verified its signed token. Selling the
// Timetable module on its own means owning the credential ourselves.
//
// WHY CREDENTIALS LIVE HERE, in the control plane, and not in `users`:
//
//   1. One person, one password, many schools. A self-serve admin may run
//      several schools; `users` is one row PER school, keyed
//      (school_id, erp_user_id). A password on that row would be a password
//      per school — several to change, several to leak.
//   2. `users` is an ERP-identity table. It records who the ERP said this
//      person is; it has never held a secret and should not start.
//   3. `platform_users` already sets the precedent: identity that outranks any
//      one school lives out here, where a school's Super Admin cannot reach it.
//
// A school's `users` row still exists for every account, unchanged — that is
// what carries the role, the scope and the audit trail. The account is only
// the credential.

/// Whether this account may create schools.
///
/// The distinction is load-bearing: a self-serve admin invites their teachers,
/// and a teacher's login must never be able to create schools of its own — on
/// the admin's cap, in the admin's billing, in the same list.
enum AccountKind {
  /// Registered themselves from the home page. May create schools.
  owner
  /// Was invited into a school. May never create one.
  member
}

enum AccountStatus {
  /// Registered, email not yet verified. May sign in to nothing.
  pending
  active
  suspended
}

/// A person who signs in with an email and a password (§15.3).
///
/// ERP users have no row here and never will — their credential is the ERP's.
/// The two identity sources are kept entirely apart on purpose: there is no
/// path by which an ERP user acquires a password, or a local account acquires
/// an ERP identity.
model Account {
  id           Int    @id @default(autoincrement())
  email        String @unique @db.VarChar(160)
  /// Encoded with its own algorithm and parameters (see password.service.ts),
  /// so the cost can be raised later and old hashes upgraded on next sign-in
  /// rather than forcing a reset.
  passwordHash String @map("password_hash") @db.VarChar(255)

  name         String  @db.VarChar(120)
  phone        String? @db.VarChar(30)
  organisation String? @db.VarChar(160)
  country      String? @db.VarChar(60)
  /// Their job, for support and sales context. Never used to authorise.
  jobRole      String? @map("job_role") @db.VarChar(60)

  kind   AccountKind   @default(owner)
  status AccountStatus @default(pending)

  emailVerifiedAt DateTime? @map("email_verified_at")
  lastLoginAt     DateTime? @map("last_login_at")

  /// Consecutive failures since the last success, and the lockout they earned.
  /// Per account; the per-IP half lives in Redis, because an attacker spraying
  /// many addresses never trips any single account's counter.
  failedLogins Int       @default(0) @map("failed_logins")
  lockedUntil  DateTime? @map("locked_until")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tokens AccountToken[]

  @@map("accounts")
}

enum AccountTokenPurpose {
  verify
  reset
  /// Phase 25.6 — inviting somebody into a school they do not yet belong to.
  invite
}

/// One-shot, expiring links: verify an address, reset a password, accept an
/// invitation.
///
/// ONE TABLE FOR ALL THREE, because they are the same object with a different
/// label, and three tables would be three places to get expiry and single-use
/// wrong.
///
/// The token itself is NEVER stored — only its SHA-256. A leaked backup of this
/// table therefore hands nobody a working link, which is the whole reason to
/// hash something that is already short-lived.
model AccountToken {
  id        Int                 @id @default(autoincrement())
  accountId Int                 @map("account_id")
  account   Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  purpose   AccountTokenPurpose
  /// SHA-256 hex of the token that was emailed. Unique so a lookup is a point
  /// read and two tokens can never collide silently.
  tokenHash String              @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime            @map("expires_at")
  usedAt    DateTime?           @map("used_at")
  /// For `invite`: which school, role and teacher the acceptance should join.
  /// Null for verify and reset, which need nothing beyond the account.
  meta      Json?
  createdAt DateTime            @default(now()) @map("created_at")

  @@index([accountId, purpose])
  @@index([expiresAt])
  @@map("account_tokens")
}
