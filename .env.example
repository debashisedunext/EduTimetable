# Copy to .env (gitignored). Compose reads this file; service hosts are compose
# service names (mysql, redis) — never localhost (see CLAUDE.md, Docker-only rule).
MYSQL_ROOT_PASSWORD=edutimetable_dev
MYSQL_DATABASE=edutimetable
JWT_SECRET=dev_only_change_me
WEB_APP_URL=http://localhost:5174
# Production: PEM public key of the Edunext ERP SSO signer (RS256). Leave empty in
# dev — the api generates an in-memory dev keypair and exposes a stub ERP token
# endpoint (/api/dev/erp-token) so the full SSO round trip works locally.
ERP_PUBLIC_KEY=
