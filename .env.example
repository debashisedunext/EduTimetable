# Copy to .env (gitignored). Compose reads this file; service hosts are compose
# service names (mysql, redis) — never localhost (see CLAUDE.md, Docker-only rule).
MYSQL_ROOT_PASSWORD=edutimetable_dev
MYSQL_DATABASE=edutimetable
JWT_SECRET=dev_only_change_me
WEB_APP_URL=http://localhost:5174
# Production: PEM public key of the Edunext ERP SSO signer (RS256). Leave empty in
# dev — the api generates an in-memory dev keypair and exposes a stub ERP token
# endpoint (/api/dev/erp-token) so the full SSO round trip works locally.
ERP_PUBLIC_KEY=

# ── Outgoing mail (§15.3)
#
# Verification, password reset and teacher invitations are all a one-shot link
# in an email, so a deployment without a working transport cannot onboard
# anybody. `smtp` is the real one; `log` writes the link to the application log
# and is the default, so an unconfigured deployment is obviously unconfigured
# rather than quietly failing to deliver.
#
# Dev needs none of this: docker-compose.override.yml points the api at the
# `mailpit` service, and every message is readable at http://localhost:8026.
MAIL_TRANSPORT=log
# MAIL_HOST=smtp.your-provider.com
# MAIL_PORT=587
# MAIL_USER=
# MAIL_PASSWORD=
# Implicit TLS. Assumed on port 465; STARTTLS is negotiated otherwise.
# MAIL_SECURE=false
# The From address. Some providers refuse anything they have not verified.
# MAIL_FROM=EduTimetable <no-reply@yourschool.edu>
